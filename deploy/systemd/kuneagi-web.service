[Unit]
Description=KuneAgi web workers (dace.wosystem, no reactor)
After=network.target kuneagi-zeo.service
# No Wants= here: topology A (single system process on file://)
# must not pull ZEO in. Topology B enables the three units
# explicitly; After= alone gives the ordering when zeo runs.

[Service]
Type=simple
User=kuneagi
Group=kuneagi
WorkingDirectory=/srv/kuneagi
ExecStart=/srv/kuneagi/app/.venv312/bin/pserve /srv/kuneagi/etc/production.ini
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kuneagi/var

[Install]
WantedBy=multi-user.target
