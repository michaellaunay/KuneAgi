###
# KuneAgi on the modern stack — production template (Phase 3).
# Copy to etc/production.ini and EDIT: secrets, URL, mail profile.
# See docs/en/production-migration.md (fr mirror available).
###

[app:main]
use = egg:novaideo

zodbconn.uri = file://%(here)s/../var/filestorage/Data.fs?blobstorage_dir=%(here)s/../var/blobstorage

# NOT optional on the modern stack: pyramid_tm reads the userid before
# traversal and substanced's groupfinder needs request.context.
tm.annotate_user = false

substanced.secret = CHANGE-ME
novaideo.secret = CHANGE-ME
substanced.uploads_tempdir = %(here)s/../var/tmp_uploads
mail.default_sender = kuneagi@example.org
available_languages = en fr de

pyramid.includes =
    pyramid_chameleon
    pyramid_layout
    pyramid_mailer
    pyramid_retry
    pyramid_tm
    substanced
    dace.wosystem
    pontus
    daceui
    deform_treepy

retry.attempts = 3
# deform 3 has no pyramid includeme: pontus installs it (M2 port).
# Web workers run dace.wosystem (no reactor). The system process adds
# dace.system — derive its ini exactly as start_system.bash does.

# --- WAKE-UP PROFILE (first boots: outbound written to disk) --------
novaideo.mail_debug = true
# novaideo.mail_debug replaces the mailer with a disk sink: every message is
# written under var/mail-out/ instead of reaching an SMTP host.
novaideo.mail_out_dir = %(here)s/../var/mail-out
sms.service = novaideo.utilities.dummy_sms.DummySMSService
# --- LIVE PROFILE (after the backlog review) ------------------------
# set novaideo.mail_debug = false and:
# mail.host = smtp.example.org
# mail.port = 587
# mail.tls = true
# mail.username = ...
# mail.password = ...
# sms.service = pyramid_sms.ovh.OvhService
# ovh.application_key = ...

[server:main]
use = egg:waitress#main
listen = 127.0.0.1:6543
threads = 4

# --- logging: make the reactor visible (re-arming logs at INFO) -----
[loggers]
keys = root, dace, novaideo

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = WARN
handlers = console

[logger_dace]
level = INFO
handlers =
qualname = dace

[logger_novaideo]
level = INFO
handlers =
qualname = novaideo

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(asctime)s %(levelname)-5.5s [%(name)s] %(message)s
